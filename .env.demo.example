# Variables de la démo « Tsena Pro » (docker-compose.demo.yml).
# Copier une seule fois : cp .env.demo.example .env.demo   puis éditer. Ne jamais commiter .env.demo.
# Éviter les caractères spéciaux shell (! @ $ ` ' ") dans les mots de passe.

# Adresse publique de la démo, sans slash final : http://IP_DU_VPS:PORT
PUBLIC_URL=http://CHANGE_ME_IP:8082
# Port publié sur le serveur (ne doit pas être utilisé par un autre site ; 8081 est pris par All)
DEMO_PORT=8082

# Base de données et cache (uniquement accessibles dans le réseau Docker)
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Secrets de session — générer avec : openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

# Compte administrateur créé par le seed (connexion : /admin/login)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Paiement Mobile Money : numéros marchands réels (un moyen sans numéro n'est pas proposé)
PAYMENT_MVOLA_NUMBER=
PAYMENT_ORANGE_MONEY_NUMBER=
PAYMENT_AIRTEL_MONEY_NUMBER=
PAYMENT_ACCOUNT_NAME="Tsena Pro"

# Paiement automatique MVola (Merchant Pay). Laisser vide = paiement manuel par référence uniquement.
# Voir MVOLA-INTEGRATION.md : identifiants à demander à MVola, validation en bac à sable AVANT la production.
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_NUMBER=
MVOLA_PARTNER_NAME=
# sandbox (défaut) ou production
MVOLA_ENV=sandbox
MVOLA_LANGUAGE=FR
# URL publique HTTPS du rappel MVola (facultatif) : https://VOTRE-SITE/api/payments/auto/callback/mvola
MVOLA_CALLBACK_URL=

# Paiement de DÉMONSTRATION : MVola, Orange Money et Airtel Money sont SIMULÉS dans le backend, sans aucun argent réel ni
# identifiant d'opérateur (bandeau « Paiement de démonstration » affiché). true = activé. Refusé automatiquement si de
# vrais identifiants d'opérateur sont renseignés ci-dessous. Ne JAMAIS activer sur un vrai site.
DEMO_PAYMENTS=true

# Paiement automatique Orange Money (Web Payment : le client paie sur la page d'Orange) et Airtel Money (demande sur
# le téléphone). Laisser vide = paiement manuel par référence uniquement. Voir OPERATEURS-INTEGRATION.md.
# Adresse publique HTTPS du site (retour du client après la page d'Orange) : obligatoire pour Orange Money.
PUBLIC_SITE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# sandbox (défaut) ou production
ORANGE_MONEY_ENV=sandbox
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
# sandbox (défaut) ou production
AIRTEL_MONEY_ENV=sandbox

# Commission de la plateforme sur les ventes des vendeurs, en % du sous-total (défaut 10).
# Réglable ensuite vendeur par vendeur dans /admin/reversements.
PLATFORM_COMMISSION_RATE=10

# Annulation automatique des commandes non payées : délai en heures (défaut 48, 0 = jamais).
# Le stock réservé est alors libéré ; une commande dont la référence de paiement est à vérifier n'est jamais annulée.
UNPAID_ORDER_EXPIRY_HOURS=48

# E-mails (optionnel : laisser vide = aucun e-mail envoyé)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=savatry.milamina@gmail.com

# Conseiller IA — optionnel. Mistral (https://console.mistral.ai), puis Gemini en secours (https://aistudio.google.com).
# Sans clé (ou si les deux échouent), le conseiller répond par une simple recherche par mots-clés.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SMS (codes de connexion par téléphone + suivi des commandes). SMS_PROVIDER : orange, twilio ou demo.
#   orange : API « SMS Madagascar » d'Orange Developer (https://developer.orange.com/apis/sms-mg), forfait à acheter
#   twilio : https://console.twilio.com (numéro expéditeur TWILIO_FROM)
#   demo   : aucun SMS, le code de connexion s'affiche sur le site (DÉMONSTRATION uniquement, jamais sur un vrai site)
# Vide : « demo » en développement, aucun SMS (et pas de connexion par téléphone) en production.
SMS_PROVIDER=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2610000
ORANGE_SMS_SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS de suivi des commandes (enregistrée, rappel de paiement, payée, expédiée, annulée) : false = codes uniquement
SMS_ORDER_NOTIFICATIONS=true

# Paiement garanti : l'argent n'est reversé au vendeur qu'une fois la commande reçue. L'acheteur peut signaler un
# problème pendant ce nombre de jours après la livraison ; sans signalement, la réception est confirmée d'office.
# 0 = réception confirmée dès la livraison (pas de délai de litige).
BUYER_PROTECTION_DAYS=3

# Paiement à la livraison (espèces au livreur ou au retrait) : clients connectés uniquement.
# L'administrateur passe la commande en « livrée » quand le livreur lui remet l'argent.
CASH_ON_DELIVERY=false
CASH_ON_DELIVERY_CITIES=Antananarivo         # villes desservies, séparées par des virgules (le retrait reste toujours possible)
CASH_ON_DELIVERY_MAX_AMOUNT=500000           # montant maximal des articles, en Ariary

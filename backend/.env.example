# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tsenapro?schema=public"

# Redis (optional) : cache, et file BullMQ des tâches récurrentes (sans REDIS_URL : simples minuteries)
REDIS_URL="redis://:password@localhost:6379"

# Tâches récurrentes exécutées par l'API (défaut). false = seulement planifiées, exécutées par `npm run worker`
# JOBS_IN_API=true

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email admin pour notifications de commandes
ADMIN_EMAIL=savatry.milamina@gmail.com

# Conseiller IA — optionnel. Mistral (https://console.mistral.ai), puis Gemini en secours (https://aistudio.google.com).
# Sans clé (ou si les deux échouent), le conseiller répond par une simple recherche par mots-clés.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SMS (codes de connexion par téléphone + suivi des commandes). SMS_PROVIDER : orange, twilio ou demo.
#   orange : API « SMS Madagascar » d'Orange Developer (https://developer.orange.com/apis/sms-mg), forfait à acheter
#   twilio : https://console.twilio.com (numéro expéditeur TWILIO_FROM)
#   demo   : aucun SMS, le code de connexion s'affiche sur le site (DÉMONSTRATION uniquement, jamais sur un vrai site)
# Vide : « demo » en développement, aucun SMS (et pas de connexion par téléphone) en production.
SMS_PROVIDER=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2610000
ORANGE_SMS_SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS de suivi des commandes (enregistrée, rappel de paiement, payée, expédiée, annulée) : false = codes uniquement
SMS_ORDER_NOTIFICATIONS=true

# Paiement garanti : l'argent n'est reversé au vendeur qu'une fois la commande reçue. L'acheteur peut signaler un
# problème pendant ce nombre de jours après la livraison ; sans signalement, la réception est confirmée d'office.
# 0 = réception confirmée dès la livraison (pas de délai de litige).
BUYER_PROTECTION_DAYS=3

# Paiement à la livraison (espèces au livreur ou au retrait) : clients connectés uniquement.
# L'administrateur passe la commande en « livrée » quand le livreur lui remet l'argent.
CASH_ON_DELIVERY=false
CASH_ON_DELIVERY_CITIES=Antananarivo         # villes desservies, séparées par des virgules (le retrait reste toujours possible)
CASH_ON_DELIVERY_MAX_AMOUNT=500000           # montant maximal des articles, en Ariary

# Parrainage : chaque client a un code personnel. Le filleul obtient une remise sur sa première commande ; le parrain
# reçoit un bon d'achat quand cette commande est payée. Remises prises en charge par la plateforme (pas le vendeur).
REFERRAL_DISCOUNT_PERCENT=10                 # remise du filleul en % (0 = parrainage désactivé)
REFERRAL_DISCOUNT_MAX=20000                  # plafond de cette remise, en Ariary
REFERRAL_REWARD_AMOUNT=5000                  # bon offert au parrain, en Ariary (0 = aucun bon)
REFERRAL_REWARD_DAYS=90                      # validité du bon, en jours

# Livraison à domicile standard / express : villes de la zone locale (séparées par des virgules). Ailleurs, le client
# choisit la livraison en province (tarifs par zone, modifiables dans l'administration > Livraison) ou un point relais.
LOCAL_DELIVERY_CITIES=Antananarivo,Ivato,Ambohidratrimo,Talatamaty,Andoharanofotsy,Ambohimangakely,Alasora,Itaosy

# Conseiller IA : limite des questions ENVOYÉES À L'IA (une réponse en cache ou la recherche par mots-clés ne comptent pas)
ADVISOR_MAX_PER_HOUR=60                      # par compte, ou par appareil sans compte
ADVISOR_MAX_PER_IP_HOUR=1000                 # par adresse IP (large : les abonnés mobiles partagent souvent la même)
ADVISOR_CATALOG_SIZE=25                      # produits envoyés à l'IA par question (les plus proches) : moins de quota consommé

# Nom affiché dans les e-mails transactionnels
PLATFORM_NAME="Tsena"

# Authentification
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Identifiants du premier compte platform_admin (consommés uniquement par le script
# de backfill prisma/backfill-b2b.ts, jamais lus au runtime des requêtes)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-in-production

# Paiement Mobile Money (vérifié manuellement). Seuls les moyens dont le numéro est renseigné sont proposés.
PAYMENT_MVOLA_NUMBER=034 00 000 00
PAYMENT_ORANGE_MONEY_NUMBER=032 00 000 00
PAYMENT_AIRTEL_MONEY_NUMBER=033 00 000 00
PAYMENT_ACCOUNT_NAME="Tsena"

# Commission de la plateforme sur les ventes des vendeurs, en % du sous-total (defaut 10). Modifiable par vendeur dans /admin/reversements.
PLATFORM_COMMISSION_RATE=10

# Annulation automatique des commandes non payees : delai en heures (defaut 48, 0 = jamais).
UNPAID_ORDER_EXPIRY_HOURS=48

# Relances automatiques (0 = désactivée) : rappel de paiement N heures avant l'annulation automatique,
# alerte au vendeur (et à l'admin) pour une commande payée non expédiée après N heures, alerte de stock bas
# sous ce seuil (relevé à la quantité minimum de commande du produit)
PAYMENT_REMINDER_HOURS_BEFORE_EXPIRY=12
SELLER_SHIPPING_ALERT_HOURS=48
LOW_STOCK_THRESHOLD=5

# Paiement automatique MVola (Merchant Pay) : vide = paiement manuel uniquement. Voir MVOLA-INTEGRATION.md
# MVOLA_CONSUMER_KEY=
# MVOLA_CONSUMER_SECRET=
# MVOLA_MERCHANT_NUMBER=034 00 000 00
# MVOLA_ENV=sandbox
# MVOLA_API_BASE_URL=http://127.0.0.1:4010   # faux serveur local : npm run mock:mvola

# Paiement de DÉMONSTRATION (opérateurs simulés dans le backend, sans argent réel ni identifiants) : DEMO_PAYMENTS=true
# DEMO_PAYMENTS=true

# Paiement automatique Orange Money (page de paiement d'Orange) et Airtel Money (demande sur le téléphone) :
# vide = paiement manuel uniquement. Voir OPERATEURS-INTEGRATION.md
# PUBLIC_SITE_URL=http://localhost:3000       # retour du client après la page d'Orange (repli : FRONTEND_URL)
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=
# ORANGE_MONEY_ENV=sandbox
# ORANGE_MONEY_API_BASE_URL=http://127.0.0.1:4011   # faux serveur local : npm run mock:operators
# AIRTEL_MONEY_CLIENT_ID=
# AIRTEL_MONEY_CLIENT_SECRET=
# AIRTEL_MONEY_ENV=sandbox
# AIRTEL_MONEY_API_BASE_URL=http://127.0.0.1:4012   # faux serveur local : npm run mock:operators

# Paiement par carte bancaire (Stripe Checkout) : proposé dès que la clé secrète est renseignée (vide = non proposé).
# Clé de test sk_test_… depuis https://dashboard.stripe.com/test/apikeys (aucun débit réel).
# Webhook facultatif (événement checkout.session.completed) : {PUBLIC_SITE_URL}/api/payments/auto/callback/stripe
# STRIPE_SECRET_KEY=
# STRIPE_CURRENCY=MGA                          # Ariary par défaut ; autre devise (EUR…) => STRIPE_MGA_RATE obligatoire
# STRIPE_MGA_RATE=5000                         # Ariary pour 1 unité de STRIPE_CURRENCY (ignoré en MGA)
# STRIPE_API_BASE_URL=http://127.0.0.1:4013    # faux serveur local : npm run mock:operators

# Paiement PayPal (Orders v2) : proposé dès que les identifiants ET le taux sont renseignés (vide = non proposé).
# Identifiants d'application depuis https://developer.paypal.com (bac à sable par défaut).
# PayPal n'accepte pas l'Ariary : les montants sont convertis au taux ci-dessous, arrondis au-dessus.
# Webhook facultatif (CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED) : {PUBLIC_SITE_URL}/api/payments/auto/callback/paypal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox                           # « production » pour les vrais paiements
# PAYPAL_CURRENCY=EUR
# PAYPAL_MGA_RATE=5000                         # Ariary pour 1 unité de PAYPAL_CURRENCY
# PAYPAL_API_BASE_URL=http://127.0.0.1:4014    # faux serveur local : npm run mock:operators

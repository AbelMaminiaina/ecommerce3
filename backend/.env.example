# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tsenapro?schema=public"

# Redis (optional)
REDIS_URL="redis://:password@localhost:6379"

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email admin pour notifications de commandes
ADMIN_EMAIL=savatry.milamina@gmail.com

# Nom affiché dans les e-mails transactionnels
PLATFORM_NAME="Tsena"

# Authentification
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Identifiants du premier compte platform_admin (consommés uniquement par le script
# de backfill prisma/backfill-b2b.ts, jamais lus au runtime des requêtes)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-in-production

# Paiement Mobile Money (vérifié manuellement). Seuls les moyens dont le numéro est renseigné sont proposés.
PAYMENT_MVOLA_NUMBER=034 00 000 00
PAYMENT_ORANGE_MONEY_NUMBER=032 00 000 00
PAYMENT_AIRTEL_MONEY_NUMBER=033 00 000 00
PAYMENT_ACCOUNT_NAME="Tsena"

# Commission de la plateforme sur les ventes des vendeurs, en % du sous-total (defaut 10). Modifiable par vendeur dans /admin/reversements.
PLATFORM_COMMISSION_RATE=10

# Annulation automatique des commandes non payees : delai en heures (defaut 48, 0 = jamais).
UNPAID_ORDER_EXPIRY_HOURS=48

# Paiement automatique MVola (Merchant Pay) : vide = paiement manuel uniquement. Voir MVOLA-INTEGRATION.md
# MVOLA_CONSUMER_KEY=
# MVOLA_CONSUMER_SECRET=
# MVOLA_MERCHANT_NUMBER=034 00 000 00
# MVOLA_ENV=sandbox
# MVOLA_API_BASE_URL=http://127.0.0.1:4010   # faux serveur local : npm run mock:mvola

# Paiement de DÉMONSTRATION (opérateurs simulés dans le backend, sans argent réel ni identifiants) : DEMO_PAYMENTS=true
# DEMO_PAYMENTS=true

# Paiement automatique Orange Money (page de paiement d'Orange) et Airtel Money (demande sur le téléphone) :
# vide = paiement manuel uniquement. Voir OPERATEURS-INTEGRATION.md
# PUBLIC_SITE_URL=http://localhost:3000       # retour du client après la page d'Orange (repli : FRONTEND_URL)
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=
# ORANGE_MONEY_ENV=sandbox
# ORANGE_MONEY_API_BASE_URL=http://127.0.0.1:4011   # faux serveur local : npm run mock:operators
# AIRTEL_MONEY_CLIENT_ID=
# AIRTEL_MONEY_CLIENT_SECRET=
# AIRTEL_MONEY_ENV=sandbox
# AIRTEL_MONEY_API_BASE_URL=http://127.0.0.1:4012   # faux serveur local : npm run mock:operators

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catégories de produits (table dynamique)
model Category {
  id          String  @id @default(uuid())
  name        String // Nom affiché (ex: "Quincaillerie")
  slug        String  @unique // Identifiant URL (ex: "quincaillerie")
  description String?
  image       String?
  order       Int     @default(0) // Ordre d'affichage
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// Badges des produits
enum ProductBadge {
  bio
  plein_air
  nouveau
  promo
  populaire
}

// Modération des produits publiés par les entreprises vendeuses
enum ProductStatus {
  pending
  approved
  rejected
}

// Statut d'un compte professionnel
enum CompanyStatus {
  pending
  approved
  rejected
  suspended
}

// Rôle d'un utilisateur
enum UserRole {
  platform_admin
  company_admin
  buyer
  customer // Particulier (achat au détail, sans entreprise)
}

// Moyen de paiement d'une commande : Mobile Money (paiement vérifié manuellement).
// Une carte bancaire nécessitera un prestataire de paiement : à ajouter ici et dans lib/payments.ts.
enum PaymentMethod {
  mvola
  orange_money
  airtel_money
}

// Cycle de paiement d'une commande : en attente du paiement du client -> référence de transaction
// transmise -> confirmé par un administrateur (ou refusé, le client peut alors ressaisir).
enum PaymentStatus {
  awaiting
  submitted
  paid
  rejected
}

// Tentative de paiement automatique via l'API d'un opérateur (MVola, Orange Money, Airtel Money) : le client
// confirme la demande sur son téléphone (MVola, Airtel) ou sur la page de paiement de l'opérateur (Orange Money),
// et le site vérifie le résultat auprès de l'opérateur.
//  pending   = demande envoyée, en attente de la confirmation du client
//  completed = payé et vérifié : les commandes sont passées en « payées »
//  failed    = refusé, expiré ou erreur : le client peut réessayer
//  review    = l'opérateur dit « payé » mais le montant ne correspond pas : à vérifier par un administrateur
enum PaymentAttemptStatus {
  pending
  completed
  failed
  review
}

// Moyen utilisé pour reverser au vendeur le produit de ses ventes (moins la commission de la plateforme)
enum PayoutMethod {
  mvola
  orange_money
  airtel_money
  bank_transfer
}

// Conditions de paiement différé accordées à une entreprise (historique : le paiement différé n'existe plus)
enum PaymentTerms {
  net_30
  net_60
}

// Statut d'une facture
enum InvoiceStatus {
  sent
  paid
  overdue
  cancelled
}

// Compte professionnel (grossiste acheteur)
model Company {
  id              String        @id @default(uuid())
  name            String
  legalName       String?
  taxId           String        @unique
  status          CompanyStatus @default(pending)
  paymentTerms    PaymentTerms?
  creditLimit     Int? // Plafond de crédit en Ariary
  contactEmail    String
  contactPhone    String?
  rejectionReason String?

  // Commission de la plateforme : pourcentage du sous-total de chaque commande du vendeur.
  // null = taux par défaut de la plateforme (variable d'environnement PLATFORM_COMMISSION_RATE).
  commissionRate    Float?
  // Où la plateforme reverse l'argent du vendeur (renseigné par le vendeur)
  payoutMethod      PayoutMethod?
  payoutNumber      String?
  payoutAccountName String?

  users        User[]
  addresses    Address[]
  orders       Order[]   @relation("BuyerOrders")
  sellerOrders Order[]   @relation("SellerOrders")
  products     Product[] @relation("SellerProducts")
  invoices     Invoice[]
  payouts      Payout[]  @relation("SellerPayouts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// Utilisateur (rattaché à une entreprise, sauf le staff plateforme)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]

  // Compte supprimé à la demande de l'utilisateur (données personnelles anonymisées, commandes conservées)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Jetons de renouvellement de session (application mobile) : seule leur empreinte SHA-256 est stockée.
// Chaque renouvellement révoque le jeton utilisé et en émet un nouveau (rotation).
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Palier de prix dégressif par quantité (au-delà de minQty, le prix unitaire devient unitPrice)
model PriceTier {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQty    Int
  unitPrice Int // Prix unitaire en Ariary à partir de minQty

  @@index([productId, minQty])
  @@map("price_tiers")
}

// Produits
model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  category         String // Slug de catégorie (underscores), libre — voir table Category
  categoryId       String? // Nouvelle relation
  categoryRef      Category?      @relation(fields: [categoryId], references: [id])
  description      String
  shortDescription String
  price            Int // Prix unitaire de base en Ariary (avant paliers)
  originalPrice    Int? // Prix original (pour les promos)
  images           String[]
  inStock          Boolean        @default(true)
  stockQuantity    Int            @default(0)
  isActive         Boolean        @default(true) // Masquer du catalogue sans supprimer
  badges           ProductBadge[]
  characteristics  String[]

  // Vente en gros
  moq        Int         @default(1) // Quantité minimum de commande
  unit       String      @default("piece") // Unité de vente (piece, carton, palette, kg...)
  priceTiers PriceTier[]

  // Logistique
  estimatedWeightKg Float? // Poids estimé indicatif — n'entre JAMAIS dans le calcul du prix
  freeShipping      Boolean   @default(false) // Si true, la commande contenant ce produit est livrée gratuitement
  availableFrom     DateTime? // Date de disponibilité — avant cette date le client peut réserver (précommande)

  // Metadata libre (accessoires, etc.)
  dimensions String?
  weight     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Publication par une entreprise vendeuse (null = produit de la plateforme)
  sellerId        String?
  seller          Company?      @relation("SellerProducts", fields: [sellerId], references: [id])
  status          ProductStatus @default(approved)
  rejectionReason String?

  orderItems OrderItem[]
  reviews    Review[]

  @@index([sellerId])
  @@index([status])
  @@map("products")
}

// Avis clients : une note de 1 à 5 (et un commentaire facultatif) par utilisateur et par produit
model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int // 1 à 5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

// Clients (historique B2C — conservé en lecture seule, plus utilisé pour les nouvelles commandes)
model Customer {
  id        String  @id @default(uuid())
  email     String  @unique
  firstName String
  lastName  String
  phone     String?

  addresses Address[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// Adresses
model Address {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  street     String
  city       String
  postalCode String
  country    String  @default("Madagascar")
  isDefault  Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// Statut des commandes
enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

// Méthode de livraison
enum DeliveryMethod {
  standard
  express
  retrait
}

// Commandes
model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  // Historique B2C (conservé, plus utilisé pour les nouvelles commandes)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Commandes B2B
  companyId String?
  company   Company? @relation("BuyerOrders", fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // Vendeur (entreprise qui a publié les produits) ; null = produits de la plateforme.
  // Un panier multi-vendeurs est scindé en une commande par vendeur (même checkoutGroup).
  // Commande sans compte (invité) : coordonnées saisies au paiement, paiement à la livraison/retrait
  guestName  String?
  guestEmail String?
  guestPhone String?

  sellerId      String?
  seller        Company? @relation("SellerOrders", fields: [sellerId], references: [id])
  checkoutGroup String?

  status         OrderStatus    @default(pending)
  deliveryMethod DeliveryMethod

  // Paiement Mobile Money (obligatoire) : la commande n'avance qu'une fois le paiement confirmé
  paymentMethod          PaymentMethod?
  paymentStatus          PaymentStatus  @default(awaiting)
  paymentReference       String? // Référence de la transaction fournie par le client
  paymentPayerPhone      String? // Numéro Mobile Money depuis lequel il a payé
  paymentSubmittedAt     DateTime?
  paidAt                 DateTime?
  paymentRejectionReason String?
  // Stock déjà décrémenté pour cette commande (à restituer en cas d'annulation)
  stockReserved          Boolean        @default(false)

  subtotal     Int // Prix en Ariary
  shippingCost Int // Prix en Ariary
  total        Int // Prix en Ariary

  // Commission de la plateforme, figée à la confirmation du paiement (commandes de vendeurs uniquement) :
  // commissionAmount = subtotal x taux ; sellerAmount = total - commissionAmount (le vendeur livre, il
  // reçoit donc aussi les frais de livraison). payoutId renseigné une fois l'argent reversé.
  commissionRate   Float?
  commissionAmount Int?
  sellerAmount     Int?
  payoutId         String?
  payout           Payout? @relation(fields: [payoutId], references: [id])

  paymentAttempts PaymentAttempt[]

  paymentTerms PaymentTerms? // Conditions de paiement figées au moment de la commande
  dueDate      DateTime? // Échéance de paiement (facturation différée)

  notes        String?
  cancelReason String?

  items   OrderItem[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([checkoutGroup])
  @@index([guestEmail])
  @@index([paymentStatus])
  @@index([paymentReference])
  @@index([payoutId])
  @@map("orders")
}

// Reversement d'un vendeur : la plateforme a envoyé `amount` Ar au vendeur pour `ordersCount` commandes
// payées et livrées (`commissionTotal` = ce qu'elle a retenu). `reference` = transaction de la plateforme.
model Payout {
  id              String       @id @default(uuid())
  sellerId        String
  seller          Company      @relation("SellerPayouts", fields: [sellerId], references: [id])
  amount          Int
  commissionTotal Int
  ordersCount     Int
  method          PayoutMethod
  reference       String
  note            String?
  paidByUserId    String?
  paidAt          DateTime     @default(now())

  orders Order[]

  createdAt DateTime @default(now())

  @@index([sellerId])
  @@map("payouts")
}

// Une tentative de paiement automatique porte sur TOUT le panier (checkoutGroup) : `amount` est la somme des
// commandes encore à payer au moment de la demande. `orderId` = commande de référence du panier.
model PaymentAttempt {
  id                  String               @id @default(uuid())
  provider            String // 'mvola' | 'orange_money' | 'airtel_money'
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkoutGroup       String?
  amount              Int
  payerPhone          String // numéro du client (vide pour Orange Money : il le saisit chez l'opérateur)
  status              PaymentAttemptStatus @default(pending)
  serverCorrelationId String?              @unique // identifiant de suivi chez l'opérateur (MVola, Airtel) ou pay_token (Orange)
  transactionId       String? // identifiant de la transaction chez l'opérateur (une fois payée)
  paymentUrl          String? // page de paiement de l'opérateur où envoyer le client (Orange Money)
  notifToken          String?              @unique // jeton de notification de l'opérateur (Orange Money)
  providerStatus      String?
  failureReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
  @@map("payment_attempts")
}

// Items de commande
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  price         Int // Prix unitaire en Ariary au moment de la commande (résolu depuis les paliers)
  availableFrom DateTime? // Date de disponibilité du produit figée au moment de la commande (réservation / précommande)

  createdAt DateTime @default(now())

  @@map("order_items")
}

// Facture (paiement différé net-30 / net-60)
model Invoice {
  id            String  @id @default(uuid())
  invoiceNumber String  @unique
  orderId       String  @unique
  order         Order   @relation(fields: [orderId], references: [id])
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  amount    Int // Montant en Ariary
  issueDate DateTime      @default(now())
  dueDate   DateTime
  status    InvoiceStatus @default(sent)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// Newsletter
model NewsletterSubscriber {
  id       String  @id @default(uuid())
  email    String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

// Messages de contact
model ContactMessage {
  id      String  @id @default(uuid())
  name    String
  email   String
  phone   String?
  subject String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("contact_messages")
}

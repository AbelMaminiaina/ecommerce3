{
  "name": "tsena-pro-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "db:migrate:deploy": "prisma migrate deploy",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && prisma db push --accept-data-loss && tsc",
    "build:docker": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "mock:mvola": "tsx src/testing/runMockMvola.ts",
    "mock:operators": "tsx src/testing/runMockOperators.ts",
    "db:backfill-b2b": "tsx prisma/backfill-b2b.ts",
    "db:reset-catalog": "tsx --env-file=.env prisma/reset-catalog.ts",
    "db:sync-images": "tsx --env-file=.env prisma/sync-catalog-images.ts",
    "db:migrate-images": "tsx --env-file=.env src/scripts/migrateImagesToFiles.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@upstash/redis": "^1.36.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.23",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  }
}
